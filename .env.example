# Groq API Key (para generación ultrarrápida de recetas y planes con LLaMA)
# Obtén tu clave gratis en: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (para visión de cámara y texto gratis)
# Obtén tu clave gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LogMeal API Key (opcional / alternativo para visión de platos)
LOGMEAL_API_KEY=your_logmeal_api_token_here

# OpenAI API Key (opcional)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
